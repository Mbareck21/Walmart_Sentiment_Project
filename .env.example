# VoC Insight Engine — LLM backend config (ALL optional; defaults to local Ollama).
# The client is OpenAI-compatible, so the same code works with Ollama / Groq / Gemini.
# Copy to ".env" and edit, or leave unset to run the free offline rules engine.

# --- Default: local Ollama (free, no key, no signup) ---
# Install: https://ollama.com  then:  ollama pull llama3.2
VOC_LLM_BASE_URL=http://localhost:11434/v1
VOC_LLM_API_KEY=ollama
VOC_LLM_MODEL=llama3.2

# --- Groq free tier (works on a deployed demo; needs a free key) ---
# VOC_LLM_BASE_URL=https://api.groq.com/openai/v1
# VOC_LLM_API_KEY=gsk_your_free_key_here
# VOC_LLM_MODEL=llama-3.1-8b-instant

# --- Google Gemini free tier (OpenAI-compatible endpoint) ---
# VOC_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# VOC_LLM_API_KEY=your_free_gemini_key
# VOC_LLM_MODEL=gemini-1.5-flash

# Max number of top-negative reviews to deep-dive, and per-call timeout (seconds).
VOC_LLM_MAX_DEEP_DIVE=25
VOC_LLM_TIMEOUT=30
